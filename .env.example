# The public deterministic Lab requires no environment variables.
# Private-agent profiles, prompts and execution are intentionally not embedded.

# Sites only: explicitly trust identity headers inserted by its dispatcher.
# Leave disabled on generic Next.js, Vercel and untrusted reverse proxies.
VG_TRUST_CHATGPT_AUTH_HEADERS=0
# Exact comma-separated Sites production authorities (host, or host:port).
# Preview, workers.dev and origin hosts must not be included.
VG_TRUSTED_SITES_HOSTS=

# Server-only owner identity for the authenticated /app demo.
# Keep authorization separate from the public contact address.
VG_OWNER_EMAIL=
# Recommended in production: prevents any secondary allowlist from widening /app.
VG_OWNER_ONLY=1

# Optional server-side comma-separated allowlist for additional demo users.
VG_AUTHORIZED_EMAILS=

# Server-only, deny-by-default owner identity for Private Capital Intelligence.
# Set one exact address or a comma-separated allowlist; do not expose these in client code.
VG_PRIVATE_CAPITAL_OWNER_EMAIL=
VG_PRIVATE_CAPITAL_OWNER_EMAILS=

# Defense simulation: optional identity allowlist applied after /app authorization.
# If omitted, the trusted workspace owner/local operator compatibility rule is used.
VG_AERIAL_SIMULATION_OWNER_EMAIL=
VG_AERIAL_SIMULATION_OWNER_EMAILS=

# Defense simulation: required second credential and signed lab-session secret.
# Set both only in the server/runtime secret manager. Never use a NEXT_PUBLIC_ name.
# The credential must be a distinct high-entropy value of at least 20 UTF-8 bytes.
VG_AERIAL_LAB_CREDENTIAL=
# Base64url (no padding), decoding to at least 32 random bytes. Rotating it revokes all lab sessions.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
VG_AERIAL_LAB_SESSION_SECRET=

# Optional developer-only identity for opening /app on 127.0.0.1.
# It is ignored outside NODE_ENV=development and is not a production login.
VG_LOCAL_DEV_MODE=0
VG_LOCAL_DEV_USER_EMAIL=
VG_LOCAL_DEV_USER_NAME=Local Operator

# Set by the packaged local launcher. It is accepted only on a loopback host.
VG_LOCAL_INSTALL_MODE=0
VG_LOCAL_BIND_ADDRESS=127.0.0.1
